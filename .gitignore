notebooks/**/*.py
notebooks/**/*.xml

# MCA Validation Tool runtime files (it unpacks its taxonomies and leaves JVM stream dumps next to the exe)
data/validation_tool/*/Taxonomies/
data/validation_tool/*/sun.net.*

